---
// src/layouts/BaseLayout.astro
import "../styles/global.css";
import { site } from "../data/portfolio";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import SEO from "../components/SEO.astro";
import { ClientRouter } from "astro:transitions";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import GoogleTagManager from "@/components/GoogleTagManager.astro";
import GoogleTagManagerNoScript from "@/components/GoogleTagManagerNoScript.astro";
import { generateSchema } from "@/lib/schema";
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article" | "profile";
  keywords?: string[];
  publishedDate?: string;
  modifiedDate?: string;
  schemaType?: "Person" | "Organization" | "Project";
  schemaName?: string;
  /*  structuredData?: {
    type: 'Person' | 'Organization' | 'BreadcrumbList' | 'Project';
    data?: Record<string, any>;
  }; */
}

const {
  title = site.title,
  description = site.description,
  ogImage = "/og-image.jpg",
  ogType = "website",
  keywords,
  publishedDate,
  modifiedDate,
  schemaType = "Person",
  schemaName,
} = Astro.props;

const schema = generateSchema({
  type: schemaType,
  description,
  name: schemaName,
  image: ogImage,
  url: Astro.url.href,
});
/* const schema = structuredData
  ? generateSchema(structuredData.type, structuredData.data)
  : generateSchema('Organization'); */
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <GoogleTagManager />
    <!-- SEO Component -->
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
      keywords={keywords}
      publishedDate={publishedDate}
      modifiedDate={modifiedDate}
      canonical={Astro.url.href}
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />

    <!-- RSS autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.title} — RSS`}
      href="/rss.xml"
    />

    <!-- Preconnect -->
    <link rel="preconnect" href="https://va.vercel-scripts.com" crossorigin />

    <!-- Astro View Transitions -->
    <ClientRouter />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

    <!--  {
      structuredData && structuredData.type === 'Organization' && (
        <script
          is:inline
          type="application/ld+json"
