      }
    </style> -->
    <GoogleAnalytics />
  </head>

  <body>
    <GoogleTagManagerNoScript />
    <a href="#main-content" class="skip-link">SALTAR AL CONTENIDO</a>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <script>
      import "../scripts/site";
    </script>

    <slot name="scripts" />
    <Analytics />
    <SpeedInsights />
  </body>
</html>

<style is:global>
  /* Skip link */
  .skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    z-index: 999;
    padding: 0.5rem 1rem;
    background: var(--color-bg);
    color: var(--color-fg);
    font-weight: 700;
    border: 2px solid currentColor;
    border-radius: 4px;
    transition: top 0.1s;
  }
  .skip-link:focus {
    top: 1rem;
  }

  /* Evita focus ring visible en main al usar skip-link */
  #main-content:focus {
    outline: none;
  }

  /* Copy button */
  .copy-btn {
    position: absolute;
    top: 12px;
    right: 12px;
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 10px;
    background: rgba(217, 168, 78, 0.12);
    border: 1px solid rgba(217, 168, 78, 0.3);
    color: var(--accent);
    cursor: pointer;
    border-radius: 3px;
    transition:
      background 0.2s,
      border-color 0.2s,
      color 0.2s;
    line-height: 1.6;
  }
  .copy-btn:hover {
    background: rgba(217, 168, 78, 0.22);
    border-color: var(--accent);
  }
  .copy-btn.copied {
    background: rgba(26, 188, 132, 0.15);
    border-color: rgba(26, 188, 132, 0.5);
    color: #1abc84;
  }
  .copy-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
