{
  "name": "vicwithgg-portfolio",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "preinstall": "node -e \"const v=process.version.match(/^v(\\d+)\\./); if(!v||v[1]<22){console.error('❌ Node 22+ requerido. Actual: '+process.version); process.exit(1)}\"",
    "start": "astro dev",
    "build": "astro check && astro build",
    "build:fast": "astro build",
    "postbuild": "pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "fonts": "bash scripts/download-fonts.sh",
    "lighthouse": "npx lighthouse http://localhost:4321 --output=html --output-path=./lighthouse-report.html --only-categories=performance,accessibility,best-practices,seo --preset=desktop",
    "lighthouse:mobile": "npx lighthouse http://localhost:4321 --output=html --output-path=./lighthouse-mobile.html --only-categories=performance,accessibility,best-practices,seo"
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^10.0.8",
    "@lucide/astro": "^1.7.0",
    "@tailwindcss/vite": "^4.2.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^6.4.7",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "pagefind": "^1.4.0",
    "prettier": "^3.4.1",
    "prettier-plugin-astro": "^0.14.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
